{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var weatherForecasts \App\Entity\WeatherForecast[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for weatherForecast in weatherForecasts %}
                <li>{{ weatherForecast.date|date('d.m.Y') }}: {{ weatherForecast.temperature }}&deg;C</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
